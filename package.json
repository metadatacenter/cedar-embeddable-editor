{
  "name": "cedar-embeddable-editor",
  "description": "A reusable Web Component for creating and editing CEDAR metadata instances.",
  "version": "1.6.0-ng21",
  "publishConfig": {
    "registry": "https://nexus.bmir.stanford.edu/repository/npm-cedar/"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:production": "ng build --configuration=production",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit:ci": "vitest run",
    "test:unit:coverage": "vitest run --coverage.enabled",
    "test:domain": "npm --prefix harness test",
    "test:domain:coverage": "npm --prefix harness run test:coverage",
    "test:bundle-size": "npm run build:production && npm --prefix visual run bundle && npm --prefix visual run check:size",
    "test:visual:prebuilt": "npm --prefix visual run prepare:all && npm --prefix visual test",
    "test:visual": "npm run build:production && npm --prefix visual run prepare:all && npm --prefix visual test",
    "test:ci:prebuilt": "npm run lint && npm run test:unit:ci && npm run test:domain:coverage && npm run test:visual:prebuilt",
    "test:ci": "npm run lint && npm run test:unit:ci && npm run test:domain:coverage && npm run test:visual",
    "package:npm:prebuilt": "npm --prefix visual run check:fresh && npm --prefix visual run check:size && node scripts/stage-npm-package.mjs && npm run check:npm-package",
    "check:npm-package": "node scripts/check-npm-package.mjs",
    "lint": "ng lint"
  },
  "dependencies": {
    "@angular/animations": "~22.1.1",
    "@angular/cdk": "^22.1.1",
    "@angular/common": "~22.1.1",
    "@angular/compiler": "~22.1.1",
    "@angular/core": "~22.1.1",
    "@angular/elements": "^22.1.1",
    "@angular/forms": "~22.1.1",
    "@angular/material": "^22.1.1",
    "@angular/material-moment-adapter": "^22.1.1",
    "@angular/platform-browser": "~22.1.1",
    "@angular/platform-browser-dynamic": "~22.1.1",
    "@angular/router": "~22.1.1",
    "@ng-select/ng-select": "23.5.1",
    "@ngx-translate/core": "^14.0.0",
    "@ngx-translate/http-loader": "^7.0.0",
    "cedar-model-typescript-library": "npm:@org.metadatacenter/cedar-model-typescript-library@0.9.2-dev.20260805.50ef2b3",
    "lodash-es": "^4.17.21",
    "moment": "^2.29.4",
    "moment-timezone": "^0.5.43",
    "ngx-mat-select-search": "^8.0.6",
    "rxjs": "^7.8.2",
    "tslib": "^2.6.2",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.1.3",
    "@angular-eslint/builder": "~14.4.0",
    "@angular-eslint/eslint-plugin": "~14.4.0",
    "@angular-eslint/eslint-plugin-template": "~14.4.0",
    "@angular-eslint/template-parser": "~14.4.0",
    "@angular/cli": "~22.1.3",
    "@angular/compiler-cli": "~22.1.1",
    "@types/lodash-es": "^4.17.11",
    "@types/node": "^20.19.43",
    "@typescript-eslint/eslint-plugin": "^6.10.0",
    "@typescript-eslint/parser": "^6.10.0",
    "@vitest/coverage-v8": "^1.6.1",
    "eslint": "^8.53.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.1",
    "jsdom": "^24.1.3",
    "prettier": "^3.1.0",
    "ts-node": "~8.10.2",
    "typescript": "~6.0.3",
    "vitest": "^1.6.1"
  }
}
