{
  "name": "cedar-embeddable-editor",
  "description": "A reusable Web Component for creating and editing CEDAR metadata instances.",
  "license": "BSD-2-Clause",
  "version": "2.0.16-dev.20260915.5652527d",
  "engines": {
    "node": "^24.15.0"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:production": "ng build --configuration=production",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit:ci": "vitest run",
    "test:unit:coverage": "vitest run --coverage.enabled",
    "test:coordinator": "ng run cedar-embeddable-editor:coordinator-test --watch=false",
    "test:domain": "npm --prefix harness test",
    "test:domain:coverage": "npm --prefix harness run test:coverage",
    "test:bundle-size": "npm run build:production && npm --prefix visual run bundle && npm --prefix visual run check:size",
    "test:package": "npm run test:visual && npm run package:npm:prebuilt",
    "test:visual:prebuilt": "bash visual/run-in-container.sh",
    "update:visual": "bash visual/run-in-container.sh --update-snapshots",
    "test:visual": "npm run build:production && bash visual/run-in-container.sh",
    "test:ci:nonvisual:prebuilt": "npm run lint && npm run typecheck && npm run test:unit:ci && npm run test:coordinator && npm run test:domain:coverage",
    "test:ci:prebuilt": "npm run test:ci:nonvisual:prebuilt && npm run test:visual:prebuilt && npm run package:npm:prebuilt",
    "typecheck": "tsc -p tsconfig.eslint.json --noEmit && tsc -p harness/tsconfig.json --noEmit && tsc -p visual/tsconfig.json --noEmit",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "test:ci": "npm run test:ci:nonvisual:prebuilt && npm run test:visual && npm run package:npm:prebuilt",
    "types:public": "tsc -p tsconfig.public-api.json",
    "package:npm:prebuilt": "npm --prefix visual run check:fresh && npm --prefix visual run check:size && npm run types:public && node scripts/stage-npm-package.mjs && npm run check:npm-package && npm run check:readme-examples",
    "check:npm-package": "node --test scripts/npm-package.test.mjs && node scripts/check-npm-package.mjs",
    "lint": "ng lint",
    "check:readme-examples": "node scripts/check-readme-examples.mjs"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true
  },
  "dependencies": {
    "@angular/cdk": "^22.1.6",
    "@angular/common": "~22.1.6",
    "@angular/compiler": "~22.1.6",
    "@angular/core": "~22.1.6",
    "@angular/elements": "^22.1.6",
    "@angular/forms": "~22.1.6",
    "@angular/material": "^22.1.6",
    "@angular/platform-browser": "~22.1.6",
    "@ngx-translate/core": "^18.0.0",
    "cedar-model-typescript-library": "npm:@org.metadatacenter/cedar-model-typescript-library@1.0.13-dev.20260915.757d636",
    "dompurify": "^3.4.13",
    "lodash-es": "^4.18.1",
    "rxjs": "^7.8.2",
    "tslib": "^2.6.2",
    "zone.js": "~0.16.3"
  },
  "devDependencies": {
    "@angular/build": "^22.1.8",
    "@angular/cli": "~22.1.8",
    "@angular/compiler-cli": "~22.1.6",
    "@eslint/js": "^10.0.1",
    "@org.metadatacenter/cedar-design-tokens": "0.1.0-dev.20260916.964cc2a9",
    "@types/lodash-es": "^4.17.11",
    "@types/node": "^24.9.2",
    "@vitest/coverage-v8": "^4.1.11",
    "angular-eslint": "^22.1.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.1.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.11"
  }
}
