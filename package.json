{
  "name": "cedar-embeddable-editor",
  "description": "A reusable Web Component for creating and editing CEDAR metadata instances.",
  "version": "1.6.0-dev.20260804.85b7ccf",
  "publishConfig": {
    "registry": "https://nexus.bmir.stanford.edu/repository/npm-cedar/"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:production": "ng build --configuration=production",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit:ci": "vitest run",
    "test:unit:coverage": "vitest run --coverage.enabled",
    "test:domain": "npm --prefix harness test",
    "test:domain:coverage": "npm --prefix harness run test:coverage",
    "test:bundle-size": "npm run build:production && npm --prefix visual run bundle && npm --prefix visual run check:size",
    "test:visual": "npm run build:production && npm --prefix visual run prepare:all && npm --prefix visual test",
    "test:ci": "npm run test:unit:ci && npm run test:domain:coverage && npm run test:visual",
    "lint": "ng lint"
  },
  "dependencies": {
    "@angular/animations": "~14.3.0",
    "@angular/cdk": "^14.2.7",
    "@angular/common": "~14.3.0",
    "@angular/compiler": "~14.3.0",
    "@angular/core": "~14.3.0",
    "@angular/elements": "^14.3.0",
    "@angular/forms": "~14.3.0",
    "@angular/material": "^14.2.7",
    "@angular/material-moment-adapter": "^14.2.7",
    "@angular/platform-browser": "~14.3.0",
    "@angular/platform-browser-dynamic": "~14.3.0",
    "@angular/router": "~14.3.0",
    "@angular/youtube-player": "^14.2.7",
    "@ng-select/ng-select": "^9.1.0",
    "@ngx-translate/core": "^14.0.0",
    "@ngx-translate/http-loader": "^7.0.0",
    "@webcomponents/custom-elements": "^1.4.3",
    "cedar-model-typescript-library": "npm:@org.metadatacenter/cedar-model-typescript-library@0.9.2-dev.20260804.f1a3784",
    "lodash-es": "^4.17.21",
    "moment": "^2.29.4",
    "moment-timezone": "^0.5.43",
    "ngx-mat-select-search": "^4.2.1",
    "rxjs": "~6.6.7",
    "tslib": "^2.6.2",
    "zone.js": "~0.12.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^14.2.13",
    "@angular-eslint/builder": "~14.4.0",
    "@angular-eslint/eslint-plugin": "~14.4.0",
    "@angular-eslint/eslint-plugin-template": "~14.4.0",
    "@angular-eslint/template-parser": "~14.4.0",
    "@angular/cli": "~14.2.13",
    "@angular/compiler-cli": "~14.3.0",
    "@types/lodash-es": "^4.17.11",
    "@types/node": "^20.19.43",
    "@typescript-eslint/eslint-plugin": "^6.10.0",
    "@typescript-eslint/parser": "^6.10.0",
    "@vitest/coverage-v8": "^1.6.1",
    "eslint": "^8.53.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.1",
    "jsdom": "^24.1.3",
    "prettier": "^3.1.0",
    "ts-node": "~8.10.2",
    "typescript": "~4.8.4",
    "vitest": "^1.6.1"
  }
}
