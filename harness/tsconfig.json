{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": false,
    "noImplicitAny": false,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node", "vitest/globals"],
    "baseUrl": ".",
    "paths": {
      "@cee/*": ["../src/app/modules/shared/*"],
      "@angular/core": ["./stubs/angular-core.ts"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "stubs/**/*.ts", "vitest.config.ts"]
}
