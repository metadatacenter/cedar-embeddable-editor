{
  "name": "cee-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Headless generative test harness for the CEDAR Embeddable Editor domain layer",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage.enabled --coverage.provider=v8 --coverage.include='src/app/modules/shared/**' --coverage.reporter=text"
  },
  "dependencies": {
    "cedar-model-typescript-library": "file:../../cedar-model-typescript-library/dist",
    "lodash-es": "^4.17.21"
  },
  "devDependencies": {
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^20.11.0",
    "@vitest/coverage-v8": "^1.6.1",
    "ajv-draft-04": "^1.0.0",
    "ajv-formats": "^3.0.1",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0",
    "yaml": "^2.9.0"
  }
}
