{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "cedar-embeddable-editor": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/cedar-embeddable-editor",
            "index": "src/index.html",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              "src/favicon.ico",
              "src/assets",
              "src/assets/i18n-cee"
            ],
            "styles": [],
            "stylePreprocessorOptions": {
              "includePaths": [
                "src"
              ]
            },
            "allowedCommonJsDependencies": [
              "moment",
              "moment-timezone"
            ],
            "extractLicenses": false,
            "sourceMap": true,
            "optimization": false,
            "browser": "src/main.ts",
            "polyfills": [
              "src/polyfills.ts"
            ]
          },
          "configurations": {
            "coordinator-test": {
              "polyfills": []
            },
            "production": {
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ],
              "optimization": true,
              "outputHashing": "none",
              "sourceMap": false,
              "extractLicenses": true,
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "3.55mb",
                  "maximumError": "3.7mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "350kb",
                  "maximumError": "400kb"
                }
              ]
            }
          }
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "port": 4400,
            "buildTarget": "cedar-embeddable-editor:build"
          },
          "configurations": {
            "production": {
              "buildTarget": "cedar-embeddable-editor:build:production"
            }
          }
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n",
          "options": {
            "buildTarget": "cedar-embeddable-editor:build"
          }
        },
        "coordinator-test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "buildTarget": "cedar-embeddable-editor:build:coordinator-test",
            "tsConfig": "tsconfig.spec.json",
            "runner": "vitest",
            "include": ["src/**/*.coordinator.spec.ts"],
            "coverage": true,
            "coverageInclude": [
              "src/app/modules/shared/service/render-scheduler.service.ts",
              "src/app/modules/shared/components/cedar-embeddable-metadata-editor-wrapper/cedar-embeddable-metadata-editor-wrapper.component.ts",
              "src/app/modules/shared/components/cedar-embeddable-metadata-editor/cedar-embeddable-metadata-editor.component.ts",
              "src/app/modules/shared/components/cedar-component-renderer/cedar-component-renderer.component.ts"
            ],
            "coverageReporters": ["text-summary", "json-summary"],
            "coverageThresholds": {
              "statements": 45,
              "branches": 35,
              "functions": 55,
              "lines": 45
            }
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "src/**/*.ts",
              "src/**/*.html",
              "visual/**/*.ts"
            ]
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false
  },
  "schematics": {
    "@schematics/angular:component": {
      "type": "component"
    },
    "@schematics/angular:directive": {
      "type": "directive"
    },
    "@schematics/angular:service": {
      "type": "service"
    },
    "@schematics/angular:guard": {
      "typeSeparator": "."
    },
    "@schematics/angular:interceptor": {
      "typeSeparator": "."
    },
    "@schematics/angular:module": {
      "typeSeparator": "."
    },
    "@schematics/angular:pipe": {
      "typeSeparator": "."
    },
    "@schematics/angular:resolver": {
      "typeSeparator": "."
    }
  }
}
